# ═══════════════════════════════════════════════════════════════════
#  hexa-sec — .env.example  (SEC-2)
#
#  LE CONTRAT : ce fichier versionné liste TOUTES les clés, leur usage,
#  et lesquelles sont REQUISES. Les clés RÉELLES vont dans `.env`
#  (gitignoré, jamais commité). Une clé absente ici = absente du système.
#
#  Chaque clé : KE Y=   # où elle va  [# REQUIRED]
#  Règle d'or :
#    - `.env`            → les clés réelles, JAMAIS commité
#    - `.env.example`    → le template, clés VIDES, commité (le contrat)
#    - chiffrement au repos, isolation par tenant (jamais partagées)
#    - `make check` valide : clés REQUISES présentes + inconnues refusées
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
#  HEXAGENTS — le harness (les LLM)
#  Requis : au moins UN provider LLM (BYOK — l'utilisateur met SA clé).
# ─────────────────────────────────────────────────────────────────
## HEXAGENTS

OPENAI_API_KEY=   # OpenAI (chat/completions)
ANTHROPIC_API_KEY=   # Anthropic (Claude)
DEEPSEEK_API_KEY=   # DeepSeek (le SLM distant)
OPENROUTER_API_KEY=   # OpenRouter (le fallback)
XAI_API_KEY=   # xAI (Grok)
GROQ_API_KEY=   # Groq (les modèles rapides)
MISTRAL_API_KEY=   # Mistral
GEMINI_API_KEY=   # Google Gemini
AZURE_OPENAI_KEY=   # Azure OpenAI (l'enterprise)
AZURE_OPENAI_ENDPOINT=   # l'endpoint Azure

# Local (optionnel — le SLM)
OLLAMA_BASE_URL=   # Ollama (le SLM local — http://localhost:11434)

# Vision / multimédia (optionnel)
FAL_KEY=   # http://fal.ai (image gen)
KREA_API_KEY=   # Krea (image gen)
ELEVENLABS_API_KEY=   # ElevenLabs (TTS)
PICOVOICE_API_KEY=   # Porcupine (wake word)

# Browser / outils (optionnel)
BROWSER_CDP_URL=   # le CDP du browser

# ─────────────────────────────────────────────────────────────────
#  HEXAWYN — k8s (le control plane)
# ─────────────────────────────────────────────────────────────────
## HEXAWYN

# Le cluster (le thin client)
KUBECONFIG=   # le kubeconfig du client (jamais partagé)  # REQUIRED
KUBERNETES_CONTEXT=   # le contexte k8s actif

# Le CP (le raisonnement)
HEXAWYN_CP_URL=   # l'URL du control plane
HEXAWYN_CP_TOKEN=   # le token d'accès au CP

# Billing multi-cloud (les données — le gate)
AWS_ACCESS_KEY_ID=   # AWS (billing)
AWS_SECRET_ACCESS_KEY=   # AWS (billing)
AZURE_CLIENT_ID=   # Azure (billing)
AZURE_CLIENT_SECRET=   # Azure (billing)
GCP_SERVICE_ACCOUNT=   # GCP (billing)
GCP_CREDENTIALS_PATH=   # GCP (billing)

# Polar (la caisse)
POLAR_API_KEY=   # Polar.sh (les paiements)
POLAR_WEBHOOK_SECRET=   # la signature des webhooks Polar

# ─────────────────────────────────────────────────────────────────
#  HEXA-HEALTH — data-stack (les vendors)
#  Requis : au moins UN vendor de données.
# ─────────────────────────────────────────────────────────────────
## HEXA-HEALTH

SNOWFLAKE_ACCOUNT=   # Snowflake
SNOWFLAKE_USER=   # Snowflake
SNOWFLAKE_PASSWORD=   # Snowflake
DATABRICKS_HOST=   # Databricks
DATABRICKS_TOKEN=   # Databricks
GCP_PROJECT_ID=   # GCP (BigQuery)
GCP_CREDENTIALS_PATH=   # GCP (BigQuery)
AWS_REGION=   # AWS (Redshift, S3, Athena)
AWS_ACCESS_KEY_ID=   # AWS (Redshift, S3, Athena)
AWS_SECRET_ACCESS_KEY=   # AWS (Redshift, S3, Athena)
AZURE_CONNECTION_STRING=   # Azure (Synapse, Blob)
KAFKA_BOOTSTRAP_SERVERS=   # Kafka
KAFKA_API_KEY=   # Kafka
FIVETRAN_API_KEY=   # Fivetran
FIVETRAN_API_SECRET=   # Fivetran
AIRBYTE_API_URL=   # Airbyte
AIRBYTE_API_TOKEN=   # Airbyte
AIRFLOW_API_URL=   # Airflow
AIRFLOW_API_TOKEN=   # Airflow
DAGSTER_API_URL=   # Dagster
DAGSTER_API_TOKEN=   # Dagster
PREFECT_API_URL=   # Prefect
PREFECT_API_TOKEN=   # Prefect
TRINO_HOST=   # Trino
TRINO_USER=   # Trino
TRINO_PASSWORD=   # Trino

# Le MCP server
HEXA_HEALTH_MCP_TOKEN=   # le token du serveur MCP  # REQUIRED

# ─────────────────────────────────────────────────────────────────
#  HEXA-SEC — la sécurité (les scanners)  ← CE REPO
#  Requis : au moins UN scanner + le mandat (loi Godfrain).
#  Sensibilité maximale : les scanners donnent accès au SI.
# ─────────────────────────────────────────────────────────────────
## HEXA-SEC

# Les sources de connaissance (API)
SHODAN_API_KEY=   # Shodan (exposition Internet — ~49 $/mois)
NVD_API_KEY=   # NVD (la base des CVE — gratuite, quota+)
CENSYS_API_ID=   # Censys (inventaire Internet)
CENSYS_API_SECRET=   # Censys (inventaire Internet)
WHOISXML_API_KEY=   # WHOIS (la surface)

# Les scanners SaaS
NESSUS_URL=   # Nessus (le serveur privé)
NESSUS_ACCESS_KEY=   # le token Nessus
NESSUS_SECRET_KEY=   # Nessus
QUALYS_USERNAME=   # Qualys (le cloud scanner)
QUALYS_PASSWORD=   # Qualys

# Le cloud (Prowler, ScoutSuite)
AWS_ACCESS_KEY_ID=   # AWS (audit cloud)
AWS_SECRET_ACCESS_KEY=   # AWS (audit cloud)
AZURE_CLIENT_ID=   # Azure (audit cloud)
AZURE_CLIENT_SECRET=   # Azure (audit cloud)
AZURE_TENANT_ID=   # Azure (audit cloud)
GCP_SERVICE_ACCOUNT=   # GCP (audit cloud)
GCP_CREDENTIALS_PATH=   # GCP (audit cloud)

# L'AD (BloodHound — avec mandat uniquement)
AD_DOMAIN=   # le domaine AD du client
AD_USERNAME=   # le compte d'audit (droits limités)
AD_PASSWORD=   # l'AD (avec mandat)

# Le MCP server
HEXA_SEC_MCP_TOKEN=   # le token du serveur MCP  # REQUIRED

# Les clés des outils SaaS (optionnel)
GITHUB_TOKEN=   # Gitleaks/TruffleHog sur les repos privés
GITLAB_TOKEN=   # Gitleaks/TruffleHog sur les repos privés
SLACK_WEBHOOK_URL=   # les notifications (Slack)

# ─────────────────────────────────────────────────────────────────
#  HEXA-CLOUD — la caisse (les paiements)
# ─────────────────────────────────────────────────────────────────
## HEXA-CLOUD

# L'auth
JWT_PRIVATE_KEY=   # la clé de signature des licences (RS256)  # REQUIRED
JWT_PUBLIC_KEY=   # la clé publique (RS256)  # REQUIRED
MAGIC_LINK_SECRET=   # la signature des magic links  # REQUIRED

# Les paiements
POLAR_API_KEY=   # Polar.sh  # REQUIRED
POLAR_WEBHOOK_SECRET=   # la signature des webhooks Polar  # REQUIRED
STRIPE_SECRET_KEY=   # Stripe (si utilisé)
STRIPE_WEBHOOK_SECRET=   # Stripe (si utilisé)

# Les emails
RESEND_API_KEY=   # Resend (les emails transactionnels)  # REQUIRED

# La base
DATABASE_URL=   # PostgreSQL  # REQUIRED
REDIS_URL=   # Valkey/Redis (la queue)  # REQUIRED

# Le chiffrement
ENCRYPTION_KEY=   # AES-256-GCM (les secrets des tenants)  # REQUIRED

# ─────────────────────────────────────────────────────────────────
#  HEXAGENTS-CLOUD — le privé (les packs)
# ─────────────────────────────────────────────────────────────────
## HEXAGENTS-CLOUD

# L'infra
DATABASE_URL=   # PostgreSQL (les tenants)  # REQUIRED
REDIS_URL=   # Valkey (la queue HC-19)  # REQUIRED

# La caisse (partagée avec hexa-cloud)
POLAR_API_KEY=   # Polar.sh  # REQUIRED
POLAR_WEBHOOK_SECRET=   # la signature des webhooks Polar  # REQUIRED

# Les canaux (les packs)
TELEGRAM_BOT_TOKEN=   # Pack Telegram (HC-24)
WHATSAPP_API_TOKEN=   # Pack WhatsApp (HC-25 — Business API)
SLACK_BOT_TOKEN=   # Pack Slack (HC-26)
SLACK_APP_TOKEN=   # Pack Slack (HC-26)

# Le social (HC-28 — le pack social)
LINKEDIN_CLIENT_ID=   # LinkedIn (l'API)
LINKEDIN_CLIENT_SECRET=   # LinkedIn
TWITTER_API_KEY=   # X
TWITTER_API_SECRET=   # X
INSTAGRAM_TOKEN=   # IG
FACEBOOK_APP_TOKEN=   # FB
TIKTOK_CLIENT_KEY=   # TikTok

# Le chiffrement
ENCRYPTION_KEY=   # AES-256-GCM (les secrets par tenant)  # REQUIRED
